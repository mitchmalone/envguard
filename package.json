{
  "name": "envguard",
  "version": "0.1.0",
  "description": "Guards your environment secrets. Catches missing env vars before your CI does.",
  "type": "module",
  "bin": {
    "envguard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli-main.js",
      "types": "./dist/cli-main.d.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check . && tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["env", "secrets", "cli", "environment", "guard", "sync"],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.0.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
